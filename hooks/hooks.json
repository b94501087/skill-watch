{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/log-prompt.js\"",
            "timeout": 5,
            "statusMessage": "skill-watch: logging prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/log-tool.js\"",
            "timeout": 5,
            "statusMessage": "skill-watch: logging tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-pattern.js\"",
            "timeout": 5,
            "statusMessage": "skill-watch: checking pattern"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-pattern.js\"",
            "timeout": 5,
            "statusMessage": "skill-watch: archiving session"
          }
        ]
      }
    ]
  }
}
